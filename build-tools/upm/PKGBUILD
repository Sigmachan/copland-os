pkgname=upm
pkgver=0.1.0
pkgrel=1
pkgdesc="Copland package manager for pacman repositories and the AUR"
arch=(x86_64)
url="https://github.com/Sigmachan/copland-os"
license=(AGPL-3.0-or-later)
depends=(git libalpm.so pacman)
makedepends=(cargo clang llvm lld gcc)
optdepends=(
  'bat: syntax-highlighted PKGBUILD review'
  'devtools: clean chroot builds'
  'downgrade: upm downgrade compatibility command'
)
provides=(paru)
conflicts=(paru)
replaces=(paru)
options=(!lto !debug)

_project_root="$(realpath "$startdir/../..")"
_source_dir="$_project_root/apps/upm"

prepare() {
  cd "$_source_dir"
  cargo fetch --locked
}

build() {
  cd "$_source_dir"
  export CARGO_TARGET_DIR="$srcdir/target"
  export CARGO_PROFILE_RELEASE_LTO=thin
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  if [[ ${UPM_BUILD_TOOLCHAIN:-llvm} == gcc ]]; then
    export RUSTFLAGS="-C target-cpu=znver5"
    cargo clean --release
    cargo build --release --locked
    return
  fi
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=znver5 -C linker=clang -C link-arg=-fuse-ld=lld"
  if ! cargo build --release --locked; then
    warning "LLVM build failed; retrying UPM itself with the system GCC linker"
    cargo clean --release
    export RUSTFLAGS="-C target-cpu=znver5"
    cargo build --release --locked
  fi
}

check() {
  cd "$_source_dir"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --locked
}

package() {
  cd "$_source_dir"
  install -Dm755 "$srcdir/target/release/upm" "$pkgdir/usr/bin/upm"
  install -Dm644 upm.conf "$pkgdir/etc/upm.conf"
  install -Dm644 man/upm.8 "$pkgdir/usr/share/man/man8/upm.8"
  install -Dm644 man/upm.conf.5 "$pkgdir/usr/share/man/man5/upm.conf.5"
  install -Dm644 completions/bash "$pkgdir/usr/share/bash-completion/completions/upm"
  install -Dm644 completions/fish "$pkgdir/usr/share/fish/vendor_completions.d/upm.fish"
  install -Dm644 completions/zsh "$pkgdir/usr/share/zsh/site-functions/_upm"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/upm/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/doc/upm/NOTICE.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/upm/README.md"
  install -d "$pkgdir/usr/share/upm/recipes"
  install -m644 recipes/*.toml "$pkgdir/usr/share/upm/recipes/"
}
